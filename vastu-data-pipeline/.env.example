# Copy to .env and fill in ONLY if you want the optional Supabase import.
# The pipeline runs fully local without this file.

# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-or-anon-key

# Notes:
# - Use the service_role key ONLY locally (it bypasses RLS).
# - The anon key works if you enabled the "approved facts readable" policy
#   in schemas/supabase_schema.sql.
# - .env is git-ignored; never commit real keys.
