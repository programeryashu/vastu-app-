{
  "expo": {
    "name": "Vastu Compass",
    "slug": "VastuCompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.programeryashu.vastucompass",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vastu Compass uses your location only to read the device compass heading so it can show which Vastu direction you are facing. Your location is never stored or shared."
      }
    },
    "android": {
      "package": "com.programeryashu.vastucompass",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vastu Compass uses your location only to read the device compass heading so it can show which Vastu direction you are facing. Your location is never stored or shared."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Vastu Compass",
      "shortName": "Vastu",
      "backgroundColor": "#FAF8F5",
      "themeColor": "#5D4E37",
      "output": "single"
    }
  }
}
